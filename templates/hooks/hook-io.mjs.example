// JSON válido pode representar valores que não são objetos de evento.
import { readFileSync } from "node:fs";

export function readStdinRaw() {
  try {
    return readFileSync(0, "utf8");
  } catch {
    return "";
  }
}

export function parseHookEvent(raw) {
  try {
    const parsed = JSON.parse(raw);
    return parsed !== null &&
      typeof parsed === "object" &&
      !Array.isArray(parsed)
      ? parsed
      : null;
  } catch {
    return null;
  }
}

// Após obter um objeto, valide os campos exigidos pelo evento específico.
// A política de bloqueio ou continuidade pertence ao chamador.
